# Copy this file to .env and fill in your own values.
# .env is already listed in .gitignore -- never commit real keys.
#
# IMPORTANT: this project reads credentials from process environment variables
# (os.getenv / os.environ), it does NOT auto-load .env by itself. Either:
#   PowerShell :  $env:AI_API_KEY="..."
#   bash/zsh   :  export AI_API_KEY="..."
# or load the file yourself (e.g. pip install python-dotenv + load_dotenv()).
#
# Keep this file ASCII-only: it may be read on a GBK (cp936) Windows console.

# --- LLM chat / vision (group 4) ---
AI_CHAT_URL=
AI_API_KEY=
AI_MODEL=

# --- Speech-to-text (optional) ---
AI_STT_URL=
AI_STT_MODEL=
AI_STT_KEY=

# --- Text-to-speech (optional) ---
AI_TTS_URL=
AI_TTS_MODEL=
AI_TTS_VOICE=
AI_TTS_KEY=

# --- Realtime duplex voice (LEGACY reference only: docs/v4-reference) ---
# The realtime entry point is deprecated -- use modules/ai/main.py --always-on.
# These are the unified names; no vendor URL is hardcoded anywhere in the repo.
AI_REALTIME_URL=
AI_REALTIME_MODEL=
AI_REALTIME_VOICE=

# --- Doubao full-duplex realtime voice -> `main.py --volc-dialog` ---
# Console: API Key management. VOLC_API_KEY is the key VALUE (a UUID-looking string),
# NOT the display name (which looks like "api-key-20260101000000").
# Endpoint: /api/v3/duplex/realtime/dialogue  (JSON events, not the legacy binary one)
# Verify without touching a microphone: python test_volc_connect.py
VOLC_API_KEY=
VOLC_DIALOG_URL=
VOLC_MODEL=
VOLC_VOICE=

# --- Local VAD for --always-on (see README 3.12) ---
# Gate = max(AI_VAD_MIN_DBFS, noise floor + AI_VAD_MARGIN_DB)
AI_VAD_MIN_DBFS=-55
AI_VAD_MARGIN_DB=6

# --- Audio devices (wired headset) ---
# Device indices live in audio_config.json (see HEADSET_TEST.md), NOT in env.
# Generate it once with:
#   python test_audio_device.py --list
#   python test_audio_device.py --input-device N --output-device M --save-config audio_config.json

# --- Barge-in debounce (wired mic is very sensitive) ---
# Ignore a barge-in within COOLDOWN ms of the previous one, and when the
# microphone RMS (16-bit) is below RMS_MIN. Raise both if aircraft noise
# keeps interrupting the assistant.
BARGE_IN_COOLDOWN_MS=700
BARGE_IN_RMS_MIN=250

# --- Server VAD tuning ---
# Moved to audio_config.json (fields: noise_reduction / vad_threshold /
# prefix_padding_ms / silence_duration_ms). See audio_config.example.json.


# 独立实时语音凭证；地址须兼容本包Realtime WebSocket协议
AI_REALTIME_API_KEY=
