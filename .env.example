# Set process environment before running; this file is a template, not auto-loaded.
# Never commit real values. These fields configure the optional Doubao RTC route.
RTC_APP_ID=
RTC_APP_KEY=
VOLCENGINE_ACCESS_KEY_ID=
VOLCENGINE_SECRET_ACCESS_KEY=
VOLC_S2S_APP_ID=
VOLC_S2S_TOKEN=
RTC_VLM_MODEL=
RTC_VLM_API_KEY=
# RTC_VLM_API_KEY/MODEL are also used by Doubao host-side observe()/describe().
# Optional compatible HTTPS endpoint override for host diagnostics:
AI_CHAT_URL=
AI_API_KEY=
AI_MODEL=
# Seed 2.1 Lite defaults to disabled in the host client; optional override:
AI_THINKING=
